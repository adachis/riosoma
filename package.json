{
  "name": "riosoma",
  "private": true,
  "version": "0.95.0-rc.1",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "themes:build": "python3 tools/build_themes.py",
    "check": "turbo run lint typecheck test",
    "e2e": "turbo run build && pnpm --filter @riosoma/e2e e2e",
    "zapier:test": "pnpm --dir integrations/zapier install --frozen-lockfile && pnpm --dir integrations/zapier test",
    "hub:test": "pnpm --dir apps/hub install --frozen-lockfile && pnpm --dir apps/hub test",
    "n8n:test": "pnpm --dir integrations/n8n install --frozen-lockfile && pnpm --dir integrations/n8n test",
    "i18n:check": "node tools/i18n_check.mjs",
    "settings:docs": "node tools/settings_reference.mjs",
    "settings:check": "node tools/settings_reference.mjs --check",
    "apps:catalog": "node tools/app_source_catalog.mjs",
    "apps:check": "node tools/app_source_catalog.mjs --check && node --test tools/app_source_catalog.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@lingui/conf": "6.12.0",
    "@lingui/format-po": "6.12.0",
    "@messageformat/parser": "5.2.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "playwright": "1.64.1",
    "prettier": "3.10.1",
    "turbo": "2.11.11",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  },
  "dependencies": {}
}
