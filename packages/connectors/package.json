{
  "name": "@riosoma/connectors",
  "version": "0.95.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./s3": {
      "types": "./dist/files/s3.d.ts",
      "import": "./dist/files/s3.js"
    },
    "./internal/*.js": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@duckdb/node-api": "1.5.5-r.5",
    "@riosoma/contracts": "workspace:*",
    "@riosoma/db": "workspace:*",
    "fast-xml-parser": "5.12.1",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@riosoma/testkit": "workspace:*",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1"
  }
}
