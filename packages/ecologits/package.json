{
  "name": "@riosoma/ecologits",
  "version": "0.95.0",
  "private": true,
  "description": "A TypeScript port of EcoLogits 0.11.1, which estimates the energy use and environmental impacts of generative model requests.",
  "license": "MPL-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@types/node": "24.19.2"
  }
}
