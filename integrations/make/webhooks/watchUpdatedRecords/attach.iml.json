{
  "url": "/databases/{{riosomaSegment(parameters.database, false)}}/webhooks",
  "method": "POST",
  "body": {
    "url": "{{webhook.url}}",
    "events": [
      "record.updated"
    ],
    "tableIds": [
      "{{riosomaSegment(parameters.table, false)}}"
    ]
  },
  "response": {
    "data": {
      "hookId": "{{body.id}}",
      "database": "{{parameters.database}}",
      "table": "{{parameters.table}}"
    }
  }
}
