{
  "name": "@riosoma/server",
  "version": "0.95.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "node --max-old-space-size=4096 ../../node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "node --max-old-space-size=4096 ../../node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "storage:move": "node dist/tools/storage-move.js"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/helmet": "13.2.0",
    "@fastify/static": "10.1.11",
    "@fastify/websocket": "11.3.7",
    "@kenjiuno/msgreader": "1.29.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@node-rs/argon2": "2.2.2",
    "@node-saml/node-saml": "5.2.0",
    "@riosoma/ai": "workspace:*",
    "@riosoma/connectors": "workspace:*",
    "@riosoma/contracts": "workspace:*",
    "@riosoma/db": "workspace:*",
    "@riosoma/ecologits": "workspace:*",
    "@riosoma/formula": "workspace:*",
    "@riosoma/ingest": "workspace:*",
    "@simplewebauthn/server": "14.1.0",
    "docx": "9.15.4",
    "exceljs": "4.4.0",
    "fastify": "5.12.8",
    "libpg-query": "18.2.4",
    "nodemailer": "10.5.0",
    "openid-client": "6.9.0",
    "otplib": "13.6.0",
    "pdf-lib": "1.17.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "postal-mime": "4.0.8",
    "pptxgenjs": "4.0.1",
    "quickjs-emscripten": "0.32.0",
    "sharp": "0.35.5",
    "xlsx": "npm:@e965/xlsx@0.20.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@riosoma/connector-service": "workspace:*",
    "@riosoma/testkit": "workspace:*",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "mongodb": "7.9.0",
    "pino-pretty": "13.2.0",
    "tsx": "4.23.15"
  }
}
