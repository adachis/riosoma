{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "riosoma-hub",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-30",
  "workers_dev": false,
  "routes": [{ "pattern": "hub.riosoma.com", "custom_domain": true }],
  "r2_buckets": [{ "binding": "FEED", "bucket_name": "riosoma-feed" }],
  "d1_databases": [
    {
      "binding": "STATS",
      "database_name": "riosoma-hub",
      "database_id": "2da260a9-8cff-4955-8351-478f53c6bf81",
      "migrations_dir": "migrations",
    },
  ],
  // Anonymous writes per network address.  The counters stay in memory and never reach D1.
  "ratelimits": [{ "name": "WRITE_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
  "vars": {
    "BUG_REPORTS_PER_INSTALL_DAY": "10",
    "BUG_NEW_ISSUES_PER_DAY": "20",
    "BUG_COMMENTS_PER_DAY": "50",
  },
  "observability": { "enabled": false },
}
