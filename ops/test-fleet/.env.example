# Copy this file to .env next to compose.yaml when a license needs accepting.
#
# Every variable below is empty by default, and compose.yaml passes the empty
# value straight through.  Nothing is accepted until this file, or your shell
# environment, sets a value.  Set a variable to the exact string its image
# expects, which is "accept" or "Y" for every image in the fleet.
#
# SQL Server 2022
# License: https://go.microsoft.com/fwlink/?linkid=2239776
FLEET_ACCEPT_MSSQL_EULA=

# Db2 Community Edition
# License: https://www.ibm.com/support/pages/node/304515
FLEET_ACCEPT_DB2_LICENSE=

# Informix Developer Edition
# License: https://www.ibm.com/support/pages/node/77955
FLEET_ACCEPT_INFORMIX_LICENSE=
