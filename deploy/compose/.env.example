# Copy to .env and fill in.  Never commit the real one.  Every setting is described in
# docs/install/settings.md.  Empty or whitespace-only settings use the server defaults or stored values.

# Profiles to run on every docker compose command, instead of repeating --profile:
# COMPOSE_PROFILES=postgres,caddy,backup
# Pin a release rather than latest, for Riosoma and its connector service alike:
# RIOSOMA_IMAGE=ghcr.io/adachis/riosoma:0.95.0-rc.1
# RIOSOMA_CONNECTORS_IMAGE=ghcr.io/adachis/riosoma-connectors:0.95.0-rc.1
# The app is published on loopback only.  Change the address and port for your own HTTPS proxy.
# RIOSOMA_PUBLISH=127.0.0.1:8080

RIOSOMA_BASE_URL=http://localhost:8080

# Your PostgreSQL, or the bundled one with --profile postgres (use the same password in both):
# RIOSOMA_DATABASE_URL=postgres://riosoma:CHANGE_ME@postgres:5432/riosoma?sslmode=disable
# POSTGRES_PASSWORD=CHANGE_ME

# The /config volume keeps a generated encryption key and setup token across restarts.
# To keep the encryption key in .env on a NEW install, generate it with openssl rand -base64 32.
# Never change it on an existing install without restoring the original key.
# RIOSOMA_SECRET_KEY=
# Optional fixed setup token, generated with openssl rand -hex 32.  When set, no setup link is
# logged.  Open <base URL>/setup#token=<token>.  It stops working after the owner exists.
# RIOSOMA_SETUP_TOKEN=

# Optional, for one-time sign-in links and notifications by email.  SMTP requires verified TLS.
# SMTP is the default transport.  See docs/install/email.md for SES, Azure Communication
# Services, Microsoft Graph, Gmail, and relay settings, all of which pass through from .env.
# RIOSOMA_MAIL_TRANSPORT=smtp
# RIOSOMA_SMTP_URL=smtps://user:password@smtp.example.com:465
# RIOSOMA_MAIL_FROM="Riosoma <riosoma@example.com>"
# Allow plaintext only for a local test mail catcher.
# RIOSOMA_SMTP_ALLOW_PLAINTEXT=false

# For a relay instead, set RIOSOMA_MAIL_FROM above, use your outbound HTTPS address, and generate
# the shared signing secret with openssl rand -hex 32.
# RIOSOMA_MAIL_TRANSPORT=relay
# RIOSOMA_MAIL_RELAY_URL=
# RIOSOMA_MAIL_RELAY_SECRET=

# No proxies are trusted by default.  Set actual proxy addresses, CIDR ranges, named ranges such
# as loopback, or a hop count.  Comma-separated lists are supported.  With --profile caddy, trust
# only Caddy's fixed address on the Compose network:
# RIOSOMA_TRUST_PROXY=172.30.52.2

# Client-side query deadline.  Server statement and lock limits default to 30s and 10s.
# RIOSOMA_DB_QUERY_TIMEOUT_MS=30000

# With --profile caddy: the domain to serve over HTTPS, whose DNS points at this machine.  Also set
# RIOSOMA_BASE_URL=https://riosoma.example.com and RIOSOMA_TRUST_PROXY=172.30.52.2 above.
# CADDY_DOMAIN=riosoma.example.com
# With --profile caddy, for organizations' custom domains: the token Caddy sends when it asks
# whether a custom domain may have a certificate.  Make one with openssl rand -hex 32.  Unset,
# custom domains get no certificates, and the main domain works as usual.  Riosoma accepts the ask
# only from Caddy's address, RIOSOMA_TLS_ASK_ADDRESSES, which defaults to it.
# RIOSOMA_TLS_ASK_TOKEN=

# With --profile backup: the backups use RIOSOMA_DATABASE_URL unless this names another address,
# for example when that URL carries Riosoma's own pooler= option, which pg_dump doesn't know.
# BACKUP_DATABASE_URL=postgres://riosoma:CHANGE_ME@postgres:5432/riosoma?sslmode=disable
# BACKUP_TIME=03:00
# BACKUP_KEEP_DAYS=14

# With --profile updater (and --profile backup, which it needs): the owner can update from
# Settings, Updates in one click.  The token is shared by Riosoma and the updater.  Make one with
# openssl rand -hex 32.
# RIOSOMA_UPDATER_TOKEN=
# How long a new version has to answer /healthz before the updater rolls it back.
# UPDATER_HEALTH_SECONDS=600

# Update checks run daily unless off, and anonymous usage counts stay off until the owner turns
# them on.  Either can be kept off here:
# RIOSOMA_UPDATE_CHECKS=off
# RIOSOMA_TELEMETRY=off

# Add search to COMPOSE_PROFILES, generate SEARXNG_SECRET with openssl rand -hex 32, and set
# RIOSOMA_SEARCH_URL=http://search:8080.  The service has no published port.
RIOSOMA_SEARCH_URL=
SEARXNG_SECRET=
# Add pdf to COMPOSE_PROFILES while keeping the other profiles, then set this address.
# RIOSOMA_PDF_RENDERER_URL=http://gotenberg:3000

# Add clamav to COMPOSE_PROFILES and enable scanning in setup or file settings after detection.
# The sidecar address tcp://clamav:3310 is detected and approved by default.
# RIOSOMA_CLAMAV_URL=tcp://clamav:3310

# Register each connected app with its callback address shown under Settings, Integrations.
# Leave these unset to let an admin enter the app there instead.
# RIOSOMA_GITHUB_OAUTH_CLIENT_ID=
# RIOSOMA_GITHUB_OAUTH_CLIENT_SECRET=
# RIOSOMA_XERO_CLIENT_ID=
# RIOSOMA_XERO_CLIENT_SECRET=
# RIOSOMA_QUICKBOOKS_CLIENT_ID=
# RIOSOMA_QUICKBOOKS_CLIENT_SECRET=
