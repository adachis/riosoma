{
	servers {
		strict_sni_host on
	}
	on_demand_tls {
		ask http://riosoma:8080/internal/tls/allow?token={$RIOSOMA_TLS_ASK_TOKEN}
	}
}

{$CADDY_DOMAIN} {
	@internal path /internal/*
	respond @internal 404
	reverse_proxy riosoma:8080 {
		header_up X-Riosoma-Public-Authority {http.request.tls.server_name}
		header_up X-Riosoma-Authority-Token {$RIOSOMA_TLS_ASK_TOKEN}
	}
}

https:// {
	tls {
		on_demand
	}
	@internal path /internal/*
	respond @internal 404
	reverse_proxy riosoma:8080 {
		header_up X-Riosoma-Public-Authority {http.request.tls.server_name}
		header_up X-Riosoma-Authority-Token {$RIOSOMA_TLS_ASK_TOKEN}
	}
}
